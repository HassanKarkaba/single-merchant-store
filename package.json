{
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "24.22.1",
    "npm": "10.2.4"
  },
  "name": "single-merchant-store",
  "private": true,
  "scripts": {
    "check": "tsc --noEmit --project config/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --config config/vite.client.config.ts",
    "build:server": "vite build --config config/vite.server.config.ts",
    "test:contracts": "node --test tests/browser/browser_contract.test.mjs",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "renderer": "node app/controllers/renderer.mjs"
  },
  "type": "module",
  "packageManager": "npm@10.2.4"
}
